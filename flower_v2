// Shy Flower v2
// Opens and sings Pachelbel's Canon when it's calm. Closes only when someone
// approaches fast enough; simple closeness alone does not close it.
// Bee detection has priority: a bee forces it open, plays the bee tune, and
// temporarily blocks closing. If already open, the flower does a happy wiggle.
// Stays closed >= 5 s, then PEEKS out before fully opening again.
//
// New in v2:
//  - Confidence: starts quiet/short, gets bolder while a person stays calm nearby,
//    fades back to timid if left alone.
//  - Sings in phrases (a few notes/bars at a time) and resumes where it left off.
//  - Peeking after hiding.
//  - Close speed depends on how scary the approach was.
//  - Light-only happy song (photoresistor on A1).
//  - Emotion sounds: scared squeak, worried "uh-oh", happy chirp, hello chirp,
//    peek "hm?", bee trill, sleepy sigh.
//  - Bee landing detection on copper tape (D7).
// Button on pin 5 = "the end": melody stops, flower slowly closes and sleeps.
// Press again to wake it up.

#include <Servo.h>

// ---------------- Pins ----------------
const int SERVO_PIN  = 2;
const int BUZZER_PIN = 8;
const int LIGHT_PIN  = A2;   // ambient light: helps coax it out of hiding
const int LIGHT2_PIN = A1;   // "sun" sensor: triggers the happy light-only song
const int TRIG_PIN   = 3;
const int ECHO_PIN   = 4;
const int BUTTON_PIN = 5;    // wired to GND when pressed (INPUT_PULLUP)
const int BEE_PIN    = 7;    // D7: copper tape wire

// ---------------- Tuning ----------------
// Servo
// Servo is driven by pulse width in microseconds. Open is the SMALLER pulse.
const int OPEN_US   = 950;
const int CLOSED_US = 1400;
// Logical positions (0 = closed, 160 = open). All the step timings and peek
// positions below are in these units; they're mapped to microseconds on write.
const int CLOSED_POS = 0;
const int OPEN_POS   = 160;
const int OPEN_STEP_MS  = 40;   // ms per degree while opening (bigger = slower)
const int CLOSE_STEP_MS = 25;   // default close speed (ms per degree)
const int SLEEP_CLOSE_STEP_MS = 50;  // slow close for "the end"

// Shyness
const unsigned long MIN_CLOSED_MS = 5000;  // stay closed at least this long
const float FAST_APPROACH_CM_S = 50.0;     // faster than this = startle
const float MILD_APPROACH_CM_S = 35.0;     // between this and FAST = mild worry
const float SCARE_RANGE_CM     = 150.0;    // startle only within this range
const float WORRY_RANGE_CM     = 100.0;    // mild worry only within this range
const float SAFE_DISTANCE_CM   = 60.0;     // backed away this far = ok to reopen
const float CALM_SPEED_CM_S    = 30.0;     // must be moving slower than this to reopen

// Close speed vs. scariness (ms per degree; smaller = faster)
const int   MILD_CLOSE_STEP_MS    = 70;    // barely worried: closes slowly
const int   NORMAL_CLOSE_STEP_MS  = 25;    // right at the startle threshold
const int   PANIC_CLOSE_STEP_MS   = 4;     // very fast approach: slams shut
const float PANIC_APPROACH_CM_S   = 150.0; // speed at which it's full panic

// Peeking
const int PEEK_POS[] = {            // open a bit, close, open more, close a bit, open lots
  CLOSED_POS + 12, CLOSED_POS, CLOSED_POS + 35, CLOSED_POS + 8, CLOSED_POS + 70
};
const int PEEK_COUNT = sizeof(PEEK_POS) / sizeof(PEEK_POS[0]);
const unsigned long PEEK_PAUSE_MS = 1200;  // look around at each step
const int PEEK_OPEN_STEP_MS  = 60;
const int PEEK_CLOSE_STEP_MS = 45;

// Confidence (0.1 = timid, 1.0 = bold)
const float CONF_MIN = 0.10;
const float CONF_START = 0.35;
const float CONF_RISE_PER_S = 0.04;        // rises while a person stays calm nearby
const float CONF_FALL_PER_S = 0.015;       // falls while left alone
const unsigned long ALONE_GRACE_MS = 20000; // alone this long before it starts to fade
const float CONF_PROUD = 0.6;              // happy chirp when it crosses this

// Singing in phrases
const int   PHRASE_NOTES_MIN = 3;          // notes per burst when timid
const int   PHRASE_NOTES_MAX = 17;         // notes per burst when bold
const unsigned long GAP_TIMID_MS = 3000;   // pause between bursts when timid
const unsigned long GAP_BOLD_MS  = 400;    // pause between bursts when bold
const float ARTIC_TIMID = 0.35;            // fraction of note sounded (shorter = "softer")
const float ARTIC_BOLD  = 0.80;
const int   RESUME_BACKUP_NOTES = 2;       // after a scare, replay this many notes
const int   octaveMultiplier = 2;          // 1 = original pitch, 2 = up one octave
const bool  LOOP_MELODY = true;            // replay after a pause
const unsigned long LOOP_PAUSE_MS = 3000;

// Hello chirp (invite visitors in)
const float HELLO_MAX_CM = 160.0;
const float HELLO_STILL_CM_S = 10.0;       // "standing still"
const unsigned long HELLO_AFTER_MS = 2000; // still for this long -> chirp
const unsigned long HELLO_COOLDOWN_MS = 25000;

// Light (ESP32 ADC is 0-4095). Flip the comparisons if your photoresistors
// read LOWER when bright.
const int LIGHT_THRESHOLD  = 100;   // A2: reopen from hiding
const int LIGHT2_THRESHOLD = 100;   // A1: happy light-only song

// Bee detection on D7
//  1 = capacitive touch (ESP32 touchRead) on a single copper tape wire
//  0 = digital: bee bridges the wire to GND, pin reads LOW
#define BEE_USE_TOUCH 0
const float BEE_TOUCH_FRACTION = 0.15;     // reading changes >15% from baseline = touched
const int   BEE_HITS_NEEDED = 2;           // consecutive 50 ms samples
const unsigned long BEE_COOLDOWN_MS = 1500;  // short debounce so repeated bee visits still react

// Bee behavior: bee reactions temporarily override the motion/shyness logic.
// This prevents a nearby person / ultrasonic reading from immediately closing
// the flower again after a bee arrives.
const unsigned long BEE_PROTECT_MS = 5000;
const unsigned long LIGHT_PROTECT_MS = 5000;   // bright light also forces a protected wake
const unsigned long WAKE_SETTLE_MS = 2500;     // ignore ultrasonic motion just after any wake
const int BEE_WIGGLE_AMOUNT = 18;      // how far to dip from fully open
const int BEE_WIGGLE_COUNT  = 3;       // number of happy dips
const int BEE_WIGGLE_STEP_MS = 12;     // fast, cheerful movement

// Bee + sun celebration: bigger/faster wiggle and a unique little song.
const int BEE_SUN_WIGGLE_AMOUNT = 28;
const int BEE_SUN_WIGGLE_COUNT  = 5;
const int BEE_SUN_WIGGLE_STEP_MS = 9;
const unsigned long BEE_SUN_PROTECT_MS = 7000;

// Ultrasonic
const unsigned long ECHO_TIMEOUT_US = 25000;
const float MAX_CM = 300.0;
const unsigned long DIST_INTERVAL_MS = 100;  // read distance every 100 ms

