// Light-only song: "Ode to Joy" (public domain), in D, played faster
const int sunMelody[] = {
 NOTE_FS4,4, NOTE_FS4,4, NOTE_G4,4, NOTE_A4,4,
 NOTE_A4,4,  NOTE_G4,4,  NOTE_FS4,4, NOTE_E4,4,
